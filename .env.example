# GitHub
GITHUB_TOKEN=ghp_your_token_here

# LLM — LiteLLM routes to whichever provider you configure
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
LLM_MODEL=gpt-4o

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=multi-agent-code-repair

# Optional: override model per agent
RESEARCH_MODEL=gpt-4o-mini
PLANNING_MODEL=gpt-4o
PATCH_MODEL=gpt-4o

# PR creation: set false to print PR payload without pushing (dry run)
PR_DRY_RUN=false

# Validation container: default none (no outbound network). Use bridge if pip must reach PyPI.
# SANDBOX_DOCKER_NETWORK=bridge
